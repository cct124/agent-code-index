{
  // 这是带注释的示例文件，用于说明 agent-code-index 的 MCP 配置约定。
  // 在真实配置环境中，应使用 JSON 配置文件，例如 `.vscode/mcp.json`，而不是当前这个示例文件。
  // 使用方式通常是：复制当前文件内容到真实的 `mcp.json`，删除注释，并替换为你的实际项目参数和密钥。
  // 推荐一个 server 条目对应一个 PROJECT_SPACE，不要让一个进程动态路由多个项目。

  // 一个 server 条目对应一个 PROJECT_SPACE。
  // 推荐按项目拆分，而不是让一个进程动态路由多个项目。
  "servers": {
    "agent-code-index-openai-compatible": {
      // MCP server 类型。当前示例按 stdio 方式启动子进程。
      "type": "stdio",

      // 启动命令。
      // 正式使用时，推荐先构建再通过 node 运行 dist 产物。
      // 本地联调时，也可以直接用 corepack + yarn + tsx 运行 TypeScript 源码入口，
      // 这样通常更容易定位启动时报错与堆栈。
      // 当前示例默认展示“直接运行 TS 源码”的开发态配置。
      "command": "corepack",

      // 启动参数。
      // 开发态联调：
      "args": ["yarn", "mcp:dev"],
      // 如果你想切换为构建产物运行，可改为：
      // "command": "node",
      // "args": ["./packages/mcp-server/dist/index.js"],

      // 传给 agent-code-index 进程的环境变量。
      "env": {
        // 逻辑项目标识；Surreal namespace 会由它自动派生。
        "PROJECT_SPACE": "project_a",

        // SurrealDB 连接配置。
        // SurrealDB RPC 地址。
        "SURREAL_URL": "ws://127.0.0.1:8100/rpc",

        // SurrealDB database 名称。
        "SURREAL_DATABASE": "default",

        // 用户名密码认证方式下的用户名。
        "SURREAL_USERNAME": "surrealdb",

        // 用户名密码认证方式下的密码。
        "SURREAL_PASSWORD": "surrealdb",

        // 是否使用 TLS 连接 SurrealDB；必须是字符串 "true" 或 "false"。
        "SURREAL_USE_TLS": "false",

        // SurrealDB 部署模式；当前支持 local 或 cloud。
        "SURREAL_DEPLOYMENT_MODE": "local",

        // Embedding provider 配置。
        // embedding provider，可选 voyage 或 openai-compatible。
        "EMBEDDING_PROVIDER": "openai-compatible",

        // embedding 模型名。
        "EMBEDDING_MODEL": "Qwen/Qwen3-Embedding-8B",

        // 向量维度；必须与模型真实输出和存储索引维度一致。
        "EMBEDDING_VECTOR_DIMENSION": "4096",

        // embedding 服务访问密钥；真实环境中不要直接提交明文值。
        "EMBEDDING_API_KEY": "${input:agentCodeIndexOpenAICompatibleApiKey}",

        // embedding 服务基础地址；使用官方默认地址时可省略。
        "EMBEDDING_BASE_URL": "https://api.siliconflow.cn/v1",

        // 检索与日志默认参数。
        // 默认检索返回数量。
        "DEFAULT_TOP_K": "10",

        // 单仓库部署时可选的默认 repositoryId。
        // 当 MCP tool 调用未显式传 repositoryId 时，adapter 可回填此值。
        // 该字段不会改变 core 层 repositoryId 仍然必填的约束。
        // 如果这里留空，那么调用 MCP tool 时必须显式传 repositoryId，否则应返回校验错误。
        "MCP_DEFAULT_REPOSITORY_ID": "repo-a",

        // 单仓库部署时可选的固定仓库根目录。
        // 当 index_repository / index_files 未显式传 rootPath 时，adapter 可回填此值。
        // 解析优先级为：tool 输入值 > MCP_REPOSITORY_ROOT > 校验错误。
        // 不建议依赖工作目录推断仓库根目录。
        "MCP_REPOSITORY_ROOT": "/workspace/repo-a",

        // 扫描仓库时默认忽略的路径模式，使用逗号分隔。
        "DEFAULT_SCAN_IGNORE_PATTERNS": "node_modules,.git,dist,build,.next",

        // 可选的根 .gitignore 绝对路径；其中的排除规则会并入扫描忽略集合。
        "DEFAULT_SCAN_GITIGNORE_PATH": "/workspace/repo-a/.gitignore",

        // native HNSW 路径的候选窗口倍数。
        "SEARCH_NATIVE_CANDIDATE_MULTIPLIER": "20",

        // native HNSW 路径的最小 efSearch。
        "SEARCH_NATIVE_EF_SEARCH_MIN": "100",

        // 日志级别，可选 debug / info / warn / error。
        "LOG_LEVEL": "info",

        // 是否启用 pretty 日志输出；必须是字符串 "true" 或 "false"。
        "LOG_PRETTY": "true",

        // 可选的本地日志文件路径；设置后会额外将日志写入本地文件。
        "LOG_FILE_PATH": "/tmp/agent-code-index/project-a.log",

        // 文件日志是否使用 pretty 格式；默认建议 false，保留结构化 JSON 更适合排查。
        "LOG_FILE_PRETTY": "false",
      },
    },
    "agent-code-index-voyage": {
      // MCP server 类型。当前示例按 stdio 方式启动子进程。
      "type": "stdio",

      // 启动命令。当前示例默认展示开发态联调配置，直接运行 TypeScript 源码入口。
      "command": "corepack",

      // 启动参数。开发态联调：
      "args": ["yarn", "mcp:dev"],
      // 构建产物运行可改为：
      // "command": "node",
      // "args": ["./packages/mcp-server/dist/index.js"],

      // 传给 agent-code-index 进程的环境变量。
      "env": {
        // 逻辑项目标识；Surreal namespace 会由它自动派生。
        "PROJECT_SPACE": "project_b",

        // SurrealDB RPC 地址。
        "SURREAL_URL": "ws://127.0.0.1:8100/rpc",

        // SurrealDB database 名称。
        "SURREAL_DATABASE": "default",

        // 用户名密码认证方式下的用户名。
        "SURREAL_USERNAME": "surrealdb",

        // 用户名密码认证方式下的密码。
        "SURREAL_PASSWORD": "surrealdb",

        // 是否使用 TLS 连接 SurrealDB；必须是字符串 "true" 或 "false"。
        "SURREAL_USE_TLS": "false",

        // SurrealDB 部署模式；当前支持 local 或 cloud。
        "SURREAL_DEPLOYMENT_MODE": "local",

        // embedding provider，可选 voyage 或 openai-compatible。
        "EMBEDDING_PROVIDER": "voyage",

        // embedding 模型名。
        "EMBEDDING_MODEL": "voyage-code-3",

        // 向量维度；必须与模型真实输出和存储索引维度一致。
        "EMBEDDING_VECTOR_DIMENSION": "1024",

        // embedding 服务访问密钥；真实环境中不要直接提交明文值。
        "EMBEDDING_API_KEY": "${input:agentCodeIndexVoyageApiKey}",

        // 默认检索返回数量。
        "DEFAULT_TOP_K": "10",

        // 单仓库部署时可选的默认 repositoryId。
        // 当 MCP tool 调用未显式传 repositoryId 时，adapter 可回填此值。
        // 该字段不会改变 core 层 repositoryId 仍然必填的约束。
        // 如果这里留空，那么调用 MCP tool 时必须显式传 repositoryId，否则应返回校验错误。
        "MCP_DEFAULT_REPOSITORY_ID": "repo-b",

        // 单仓库部署时可选的固定仓库根目录。
        // 当 index_repository / index_files 未显式传 rootPath 时，adapter 可回填此值。
        // 解析优先级为：tool 输入值 > MCP_REPOSITORY_ROOT > 校验错误。
        // 不建议依赖工作目录推断仓库根目录。
        "MCP_REPOSITORY_ROOT": "/workspace/repo-b",

        // 扫描仓库时默认忽略的路径模式，使用逗号分隔。
        "DEFAULT_SCAN_IGNORE_PATTERNS": "node_modules,.git,dist,build,.next",

        // 可选的根 .gitignore 绝对路径；其中的排除规则会并入扫描忽略集合。
        "DEFAULT_SCAN_GITIGNORE_PATH": "/workspace/repo-b/.gitignore",

        // native HNSW 路径的候选窗口倍数。
        "SEARCH_NATIVE_CANDIDATE_MULTIPLIER": "20",

        // native HNSW 路径的最小 efSearch。
        "SEARCH_NATIVE_EF_SEARCH_MIN": "100",

        // 日志级别，可选 debug / info / warn / error。
        "LOG_LEVEL": "info",

        // 是否启用 pretty 日志输出；必须是字符串 "true" 或 "false"。
        "LOG_PRETTY": "true",

        // 可选的本地日志文件路径；设置后会额外将日志写入本地文件。
        "LOG_FILE_PATH": "/tmp/agent-code-index/project-b.log",

        // 文件日志是否使用 pretty 格式；默认建议 false，保留结构化 JSON 更适合排查。
        "LOG_FILE_PRETTY": "false",
      },
    },
  },
}
