# SurrealDB connection
# SurrealDB 服务地址，本地部署通常使用 ws://127.0.0.1:8000/rpc。
SURREAL_URL=ws://127.0.0.1:8000/rpc
# SurrealDB 使用的 namespace，用于隔离不同业务空间。
SURREAL_NAMESPACE=agent_code_index
# SurrealDB 使用的 database 名称。
SURREAL_DATABASE=default
# 用户名密码认证方式下的用户名。
SURREAL_USERNAME=root
# 用户名密码认证方式下的密码。
SURREAL_PASSWORD=root
# Token 认证方式下的访问令牌；如果使用用户名密码认证可留空。
SURREAL_TOKEN=
# 是否通过 TLS 连接 SurrealDB，true 表示启用，false 表示关闭。
SURREAL_USE_TLS=false
# SurrealDB 部署模式，可选 local 或 cloud。
SURREAL_DEPLOYMENT_MODE=local

# Voyage
# Voyage API 的访问密钥。
VOYAGE_API_KEY=
# Voyage 使用的 embedding 模型名称。
VOYAGE_MODEL=voyage-code-3

# Indexing defaults
# 默认语义检索返回的结果数量。
DEFAULT_TOP_K=10
# 扫描仓库时默认忽略的路径模式，多个值使用逗号分隔。
DEFAULT_SCAN_IGNORE_PATTERNS=node_modules,.git,dist,build,.next
