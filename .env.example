# SurrealDB connection
# SurrealDB 服务地址，本地部署通常使用 ws://127.0.0.1:8000/rpc。
SURREAL_URL=ws://127.0.0.1:8000/rpc
# MCP 绑定的逻辑项目空间；SurrealDB namespace 会由该值自动派生。
PROJECT_SPACE=agent_code_index
# SurrealDB 使用的 database 名称。
SURREAL_DATABASE=default
# 用户名密码认证方式下的用户名。
SURREAL_USERNAME=root
# 用户名密码认证方式下的密码。
SURREAL_PASSWORD=root
# Token 认证方式下的访问令牌；如果使用用户名密码认证可留空。
SURREAL_TOKEN=
# 是否通过 TLS 连接 SurrealDB，true 表示启用，false 表示关闭。
SURREAL_USE_TLS=false
# SurrealDB 部署模式，可选 local 或 cloud。
SURREAL_DEPLOYMENT_MODE=local

# Embedding
# 当前项目使用的 embedding provider，可选 voyage 或 openai-compatible。
EMBEDDING_PROVIDER=voyage
# 当前项目绑定的 embedding 模型名称。
EMBEDDING_MODEL=voyage-code-3
# 当前模型输出的向量维度，需要与存储层索引配置一致。
EMBEDDING_VECTOR_DIMENSION=1024
# embedding 服务访问密钥；当前 voyage 与 openai-compatible 都要求提供。
EMBEDDING_API_KEY=
# embedding 服务的可选基础地址，使用官方默认地址时可留空。
EMBEDDING_BASE_URL=

# Indexing defaults
# 默认语义检索返回的结果数量。
DEFAULT_TOP_K=10
# MCP adapter 在单仓库部署下使用的默认 repositoryId；未设置时，tool 调用需显式传入 repositoryId。
MCP_DEFAULT_REPOSITORY_ID=
# 扫描仓库时默认忽略的路径模式，多个值使用逗号分隔。
DEFAULT_SCAN_IGNORE_PATTERNS=node_modules,.git,dist,build,.next
# native HNSW 路径的候选窗口倍数。
SEARCH_NATIVE_CANDIDATE_MULTIPLIER=20
# native HNSW 路径的最小 efSearch。
SEARCH_NATIVE_EF_SEARCH_MIN=100

# Logging
# 日志级别，可选 debug / info / warn / error。
LOG_LEVEL=info
# 是否启用 pretty 日志输出。
LOG_PRETTY=true
